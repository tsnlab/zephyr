menuconfig ETH_LAN865X
	bool "LAN865X 10BASE-T1S Controller"
	default y
	depends on DT_HAS_MICROCHIP_LAN865X_ENABLED
	select SPI
	select NET_L2_ETHERNET_MGMT
	help
	  The LAN865X is a low power, 10BASE-T1S transceiver compliant with
	  the IEEE® 802.3cg-2019™ Ethernet standard for long reach, 10
	  Mbps single pair Ethernet (SPE).

	  Featuring an integrated media access control (MAC) and a PHY,
	  the LAN865X enables direct connectivity with a variety of controllers
	  via a serial peripheral inter-face (SPI).

if ETH_LAN865X

config ETH_LAN865X_INIT_PRIORITY
	int "LAN865X driver init priority"
	default 50
	help
	  LAN865X device driver initialization priority.
	  Must be initialized after SPI.


config ETH_LAN865X_IRQ_THREAD_STACK_SIZE
	int "Stack size for a thread that processes IRQ and Polling"
	default 512
	help
	  Size of the stack used for internal thread which is ran to
	  process raised INT IRQ and Polling.

config ETH_LAN865X_IRQ_THREAD_PRIO
	int "Priority for internal incoming packet handler"
	default 10
	help
	  Priority level for internal thread which is ran for LAN
	  INT IRQ and Polling processing.

config ETH_LAN865X_TIMEOUT
	int "IP buffer timeout"
	default 100
	help
	  Given timeout in milliseconds. Maximum amount of time
	  that the driver will wait from the IP stack to get
	  a memory buffer.

config ETH_LAN865X_POLL_INTERVAL_MS
	int "LAN865x polling interval (ms)"
	default 1
	range 1 1000
	help
	  Polling interval used when IRQ is disabled or unavailable.
	  Smaller values reduce RX latency but increase CPU load.

config ETH_LAN865X_USE_IRQ
	bool "Use LAN865X IRQ mode"
	default n
	help
	  Enable GPIO interrupt based RX handling for LAN865X.
	  If disabled, the driver operates in polling mode.

config ETH_LAN865X_BURST_CHUNKS
	int "LAN865x burst chunk count"
	default 1
	range 1 128
	help
	  Number of data chunks transferred in one SPI transaction
	  for both RX and TX paths of the LAN865x driver.

	  Each chunk carries 64 bytes of payload.
	  Value 1 keeps the legacy single-chunk behavior.
	  Larger values increase burst size and may improve throughput.

config ETH_LAN865X_OA_TC6_CREDIT_BASED_XFER
	bool "Use credit-based OA-TC6 transaction path"
	default y
	help
	  Enable the credit-based OA-TC6 data transaction path for LAN865X.

	  When enabled, the OA-TC6 layer builds SPI data transactions
	  from TX credit and RX chunk availability instead of using
	  the legacy send/read chunk paths.

	  This path keeps the OA-TC6 transaction logic generic and
	  allows the underlying SPI controller driver to use an
	  optimized transfer path when available.

endif # ETH_LAN865X
