if SOC_BCM2712

config NUM_IRQS
	default 280

config SYS_CLOCK_HW_CYCLES_PER_SEC
	default 54000000

# Enable pinctrl by default for BCM2712
config PINCTRL
	default y

# Enable GPIO by default for BCM2712
config GPIO
	default y

endif
