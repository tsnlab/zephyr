#include <zephyr/dt-bindings/gpio/gpio.h>

/ {
	joints0: joints0 {
		compatible = "zephyr,h-bridge-stepper";

		gpios = <&gpio0 17 GPIO_ACTIVE_HIGH>,
				<&gpio0 27 GPIO_ACTIVE_HIGH>,
				<&gpio0 0 GPIO_ACTIVE_HIGH>,
				<&gpio0 5 GPIO_ACTIVE_HIGH>,
				<&gpio0 13 GPIO_ACTIVE_HIGH>,
				<&gpio0 19 GPIO_ACTIVE_HIGH>;
	};

	buttons: buttons {
		compatible = "gpio-keys";

		buttons0: buttons0 {
			gpios = <&gpio0 22 GPIO_ACTIVE_HIGH>,
					<&gpio0 6 GPIO_ACTIVE_HIGH>,
					<&gpio0 26 GPIO_ACTIVE_HIGH>;
		};
	};

	aliases {
		joints0 = &joints0;
		buttons0 = &buttons0;
	};
};

&gpio0 {
	status = "okay";
};

&{/soc} {
	spi0: spi@fe204000 {
		compatible = "brcm,bcm2711-spi";
		reg = <0xfe204000 0x18>;
		status = "okay";

		clock-frequency = <250000000>;

		#address-cells = <1>;
		#size-cells = <0>;

		clk-gpios = <&gpio0 11 GPIO_ACTIVE_HIGH>;
		mosi-gpios = <&gpio0 10 GPIO_ACTIVE_HIGH>;
		miso-gpios = <&gpio0 9 GPIO_ACTIVE_HIGH>;
		cs-gpios = <&gpio0 8 GPIO_ACTIVE_LOW>;

		lan8651: lan865x@0 {
			compatible = "microchip,lan865x";
			reg = <0>;

			spi-max-frequency = <25000000>;

#if defined(CONFIG_ROBOTARM_SLAVE_IS_FIRST)
			local-mac-address = [aa bb cc 00 00 11];
#else
			local-mac-address = [aa bb cc 00 00 22];
#endif

			rst-gpios = <&gpio0 4 GPIO_ACTIVE_LOW>;
			int-gpios = <&gpio0 21 GPIO_ACTIVE_LOW>;

			status = "okay";

			lan865x_mdio: lan865x-mdio {
				compatible = "microchip,lan865x-mdio";
				status = "okay";
				#address-cells = <1>;
				#size-cells = <0>;

				ethernet-phy@0 {
					compatible = "microchip,t1s-phy";
					reg = <0>;

					plca-enable;
#if defined(CONFIG_ROBOTARM_SLAVE_IS_FIRST)
					plca-node-id = <1>;
#else
					plca-node-id = <2>;
#endif
					plca-node-count = <3>;
					plca-burst-count = <0>;
					plca-burst-timer = <0x80>;
					plca-to-timer = <0x20>;

					status = "okay";
				};
			};
		};
	};
};